---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import TextLink from '../components/TextLink.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticlePreview from '../components/ArticlePreview.astro';
---

<BaseLayout lang="en" title="Henrique Mirai">
  <main>
     <PageIntro
      title="About"
      description="I'm Henrique Mirai, a design engineer working at the intersection of design, technology and digital experiences."
    />

<section
  class="project-card-test"
  aria-label="Projects"
>
  <ProjectCard
    variant="featured"
    title="Featured project"
    description="A marketing website designed and developed to communicate the brand's value proposition and support its digital strategy."
    context="Professional / Website"
    image="https://placehold.co/688x373"
    imageAlt="Featured project preview"
    href="#top"
    ctaLabel="View case study"
  />

  <div
    class="project-card-test__divider"
    aria-hidden="true"
  ></div>

  <ProjectCard
    title="Project One"
    description="A digital experience focused on usability, visual consistency and business objectives."
    context="Freelance / Website"
    image="https://placehold.co/688x373"
    imageAlt="Project One preview"
    href="#top"
    ctaLabel="View case study"
  />

  <ProjectCard
    title="Project Two"
    description="A website combining design, development and technology to deliver a cohesive digital experience."
    context="Concept / Website"
    image="https://placehold.co/688x373"
    imageAlt="Project Two preview"
    href="#top"
    ctaLabel="View case study"
  />
</section>

<section
  class="article-preview-test"
  aria-label="Articles"
>
  <ArticlePreview
    category="Design Engineering"
    title="The Long, Hard, Stupid Way"
    description="Reflections on the relationship between design, development and the process of building digital experiences."
    href="#top"
  />

  <ArticlePreview
    category="Artificial Intelligence"
    title="Designing with Artificial Intelligence"
    description="Exploring how artificial intelligence can transform the way designers and developers approach their work."
    href="#top"
  />

  <ArticlePreview
    category="Web Development"
    title="Building Better Marketing Websites"
    description="A practical perspective on the intersection of technology, design and business objectives."
    href="#top"
  />

  <ArticlePreview
    category="Design"
    title="A Guide to Working in Public"
    description="Thoughts on documenting creative processes, sharing knowledge and learning through experimentation."
    href="#top"
  />
</section>

<div class="button-test">
  <Button
    label="Link interno"
    href="/works/"
  />

  <Button
    label="Link externo"
    href="https://github.com/"
  />

  <Button
    label="Executar ação"
    type="button"
  />

  <Button
    label="Botão desabilitado"
    disabled
  />

  <Button
    label="Link desabilitado"
    href="/works/"
    disabled
  />

  <Button
    label="Presentacional"
    presentational
  />
</div>

<a class="presentational-test" href="/works/">
  <p>Área clicável de teste</p>

  <Button
    label="View case study"
    presentational
  />
</a>
	<div class="text-link-test">
		<p>
		Conheça meus <TextLink href="/projetos/">projetos</TextLink>.
		</p>

		<p>
		Visite meu <TextLink href="https://github.com/">
		GitHub
		</TextLink>.
		</p>
	</div>
  </main>
</BaseLayout>

<style>
  .button-test {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 2rem;
  }
  .text-link-test {
    grid-column: 1 / -1;
    padding-block: 2rem;
  }

  .text-link-test p + p {
    margin-top: 1rem;
  }
.presentational-test {
  grid-column: 1 / -1;

  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1rem;

  padding: 2rem;
  border: 1px dashed var(--color-border-decorative);

  color: var(--color-text-primary);
  text-decoration: none;
  cursor: pointer;
}

.presentational-test:hover,
.presentational-test:focus-visible {
  --button-bg: var(--color-cream);
  --button-text: var(--color-brown);
}

.presentational-test:focus-visible {
  outline: 2px solid var(--color-light-ochre);
  outline-offset: 3px;
}

.project-card-test {
  grid-column: 1 / -1;

  display: grid;
  grid-template-columns: subgrid;
  column-gap: var(--layout-grid-gutter);
  row-gap: 3rem;

  padding-block: 3rem;
}

.project-card-test__divider {
  grid-column: 1 / -1;

  height: 1px;
  background-color: var(--color-border-decorative);
}

.article-preview-test {
  grid-column: 1 / -1;

  display: grid;
  grid-template-columns: subgrid;
  column-gap: var(--layout-grid-gutter);
  row-gap: 3rem;

  padding-block: 3rem;
}

</style>