---
interface Props {
  lang: 'en' | 'pt-BR';
}

const { lang } = Astro.props;

const isEnglish = lang === 'en';

const email = isEnglish
  ? 'henrique@henriquemirai.com'
  : 'henrique@henriquemirai.com.br';

const linkedinUrl = 'https://www.linkedin.com/in/henriquemirai/';

const year = new Date().getFullYear();

const backToTopLabel = isEnglish
  ? 'Back to top'
  : 'Voltar ao topo';

const copyright = isEnglish
  ? `© ${year} All Rights Reserved`
  : `© ${year} Todos os direitos reservados`;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <nav
      class="site-footer__links"
      aria-label={isEnglish ? 'Footer links' : 'Links do rodapé'}
    >
      <a class="site-footer__link" href={`mailto:${email}`}>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
        <span>Email</span>
      </a>

      <span class="site-footer__separator" aria-hidden="true">|</span>

      <a
        class="site-footer__link"
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.35-1.52 2.78-1.52 2.97 0 3.59 1.95 3.59 4.49v5.28Z" />
        </svg>
        <span>LinkedIn</span>
      </a>

      <span class="site-footer__separator" aria-hidden="true">|</span>

      <a class="site-footer__link" href="#top">
        <span>{backToTopLabel}</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M12 2 3 11l2.8 2.8 4.2-4.2V22h4V9.6l4.2 4.2L21 11 12 2Z" />
        </svg>
      </a>
    </nav>

    <p class="site-footer__copyright">{copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 1300px;
    margin-inline: auto;
    margin-top: 5rem;
    padding-block: .5rem;
    border-top: 1px solid var(--color-ochre);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .site-footer__links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    column-gap: 0.75rem;
    row-gap: 0.5rem;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2.75rem;

    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--type-size-auxiliary);
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
    text-decoration: none;

    transition: color 180ms ease;
  }

  .site-footer__link:hover {
    color: var(--color-light-ochre);
  }

  .site-footer__link:focus-visible {
    outline: 2px solid var(--color-light-ochre);
    outline-offset: 3px;
  }

  .site-footer__link svg {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .site-footer__separator {
    color: var(--color-ochre);
    font-family: var(--font-body);
    font-size: var(--type-size-auxiliary);
    line-height: 1;
  }

  .site-footer__copyright {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: var(--font-weight-regular);
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 47.999rem) {
    .site-footer {
      margin-top: 3rem;
      padding-block: 1.25rem 1.5rem;
    }

    .site-footer__links {
      column-gap: 0.5rem;
    }

    .site-footer__link {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__link {
      transition: none;
    }
  }
</style>