---
import type { getHomeProjects } from '../lib/projects';

interface Props {
  projects: Awaited<ReturnType<typeof getHomeProjects>>;
  label: string;
}

const { projects, label } = Astro.props;
---

{projects.length > 0 && (
  <ul
    class="home-project-gallery"
    aria-label={label}
    role="list"
  >
    {projects.map(({ entry, href }) => (
      <li class="home-project-gallery__item">
        <a
          class="home-project-gallery__link"
          href={href}
          aria-label={entry.data.title}
        >
          <img
            class="home-project-gallery__image"
            src={entry.data.image.src}
            alt={entry.data.imageAlt}
            width={entry.data.image.width}
            height={entry.data.image.height}
            decoding="async"
          />

          <span class="home-project-gallery__label">
            {entry.data.title}
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .home-project-gallery {
    grid-column: 1 / -1;

    display: grid;
    grid-template-columns: subgrid;
    column-gap: var(--layout-grid-gutter);
    row-gap: var(--layout-grid-gutter);

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-project-gallery__item {
    grid-column: span 3;
    min-width: 0;
    align-self: start;
  }

  .home-project-gallery__link {
    position: relative;
    display: block;

    border-radius: var(--radius);
    text-decoration: none;
  }

  .home-project-gallery__image {
    display: block;

    width: 100%;
    height: auto;

    border-radius: var(--radius);
  }

  .home-project-gallery__label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;

    max-width: 85%;
    padding: 0.5rem 0.75rem;

    border-radius: 0.75rem;

    background-color: var(
      --color-project-thumbnail-label-bg,
      var(--color-ochre)
    );

    color: var(
      --color-project-thumbnail-label-text,
      var(--color-charcoal)
    );

    font-family: var(--font-display);
    font-weight: var(--font-weight-regular);
    font-size: 1.125rem;
    line-height: 1.2;

    overflow-wrap: anywhere;

    transition: background-color 180ms ease;
  }

  .home-project-gallery__link:hover
  .home-project-gallery__label,
  .home-project-gallery__link:focus-visible
  .home-project-gallery__label {
    background-color: var(
      --color-project-thumbnail-label-hover-bg,
      var(--color-cream)
    );
  }

  .home-project-gallery__link:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .home-project-gallery__item {
      grid-column: span 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-project-gallery__label {
      transition: none;
    }
  }
</style>