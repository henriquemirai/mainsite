---
interface Props {
  lang: 'en' | 'pt-BR';
  languageLinks?: {
    en: string;
    ptBR: string;
  };
}

const {
  lang,
  languageLinks = {
    en: '/',
    ptBR: '/br/',
  },
} = Astro.props;

const isEnglish = lang === 'en';
const prefix = isEnglish ? '' : '/br';

interface NavigationItem {
  label: string;
  href: string;
  external?: boolean;
}

const navigation: NavigationItem[] = [
  {
    label: isEnglish ? 'About' : 'Sobre',
    href: `${prefix}/${isEnglish ? 'about' : 'sobre'}/`,
  },
  {
    label: isEnglish ? 'Works' : 'Projetos',
    href: `${prefix}/${isEnglish ? 'works' : 'projetos'}/`,
  },
  {
    label: isEnglish ? 'Articles' : 'Artigos',
    href: `${prefix}/${isEnglish ? 'articles' : 'artigos'}/`,
  },
];

const homeHref = isEnglish ? '/' : '/br/';

const normalizePath = (path: string) =>
  path.replace(/\/+$/, '') || '/';

const currentPath = normalizePath(Astro.url.pathname);

function getAriaCurrent(
  href: string
): 'page' | 'location' | undefined {
  const normalizedHref = normalizePath(href);

  if (currentPath === normalizedHref) {
    return 'page';
  }

  if (currentPath.startsWith(`${normalizedHref}/`)) {
    return 'location';
  }

  return undefined;
}

---

<header class="site-header">
  <a
    class="site-header__logo"
    href={homeHref}
    aria-label={isEnglish ? 'Home' : 'Página inicial'}
  >
    <img
      src="/images/logo.svg"
      alt=""
      width="88"
      height="88"
    />
  </a>

  <!-- Desktop navigation -->

  <nav
    class="site-header__desktop-nav"
    aria-label={isEnglish ? 'Main navigation' : 'Navegação principal'}
  >
    {navigation.map((item) => (
      <a
        href={item.href}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener noreferrer' : undefined}
        aria-current={getAriaCurrent(item.href)}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <!-- Desktop language selection -->

  <nav
    class="site-header__desktop-languages"
    aria-label={isEnglish ? 'Language selection' : 'Seleção de idioma'}
  >
    <a
      href={languageLinks.en}
      lang="en"
      aria-current={isEnglish ? 'true' : undefined}
    >
      EN
    </a>

    <a
      href={languageLinks.ptBR}
      lang="pt-BR"
      aria-current={!isEnglish ? 'true' : undefined}
    >
      PT-BR
    </a>
  </nav>

  <!-- Mobile navigation -->

  <details class="site-header__mobile">
    <summary
      class="site-header__menu-toggle"
      aria-label={isEnglish ? 'Toggle navigation' : 'Abrir ou fechar navegação'}
    >
      <span class="site-header__menu-icon" aria-hidden="true"></span>
    </summary>

    <nav
      class="site-header__mobile-panel"
      aria-label={isEnglish ? 'Mobile navigation' : 'Navegação mobile'}
    >
      {navigation.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          aria-current={getAriaCurrent(item.href)}
        >
          {item.label}
        </a>
      ))}

      <div class="site-header__mobile-languages">
        <a
          href={languageLinks.en}
          lang="en"
          aria-current={isEnglish ? 'true' : undefined}
        >
          EN
        </a>

        <a
          href={languageLinks.ptBR}
          lang="pt-BR"
          aria-current={!isEnglish ? 'true' : undefined}
        >
          PT-BR
        </a>
      </div>
    </nav>
  </details>
</header>

<style>
  /* Base */

  .site-header {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-block: 1rem;
  }

  /* Logo */

  .site-header__logo {
    display: block;
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
  }

  .site-header__logo img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Shared links */

  .site-header a {
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: var(--font-weight-regular);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-header a:hover {
    color: var(--color-text-hover);
  }

  .site-header a:focus-visible,
  .site-header__menu-toggle:focus-visible {
    outline: 2px solid var(--color-light-ochre);
    outline-offset: 3px;
  }

  .site-header a[aria-current="true"],
  .site-header a[aria-current="page"],
  .site-header a[aria-current="location"] {
    font-weight: var(--font-weight-bold);
  }

  /* Desktop */

  .site-header__desktop-nav,
  .site-header__desktop-languages {
    display: flex;
    align-items: center;
  }

  .site-header__desktop-nav {
    gap: 0;
    margin-left: auto;
  }

  /* Desktop navigation separators */

  .site-header__desktop-nav a:not(:last-child)::after {
    content: '/';
    display: inline-block;
    margin-inline: .65rem;
    color: var(--color-ochre);
    font-weight: var(--font-weight-regular);
  }

  .site-header__desktop-languages {
    gap: 0;
    margin-left: 1.5rem;
  }

  .site-header__desktop-languages a:not(:last-child)::after {
    content: '/';
    display: inline-block;
    margin-inline: .65rem;
    color: var(--color-ochre);
    font-weight: var(--font-weight-regular);
  }

  .site-header__mobile {
    display: none;
  }

  /* Mobile */

  @media (max-width: 47.999rem) {
    .site-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 3rem;
      align-items: start;
      column-gap: 1rem;
      row-gap: 0;
      padding-block: 0.75rem;
    }

    .site-header__logo {
      grid-column: 1;
      grid-row: 1;
      width: 3rem;
      height: 3rem;
    }

    .site-header__desktop-nav,
    .site-header__desktop-languages {
      display: none;
    }

    /*
     * The details element occupies the second column.
     * When opened, it spans the full header width.
     * The logo remains in the first row.
     */

    .site-header__mobile {
      display: block;
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
    }

    .site-header__mobile[open] {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 3rem;
    }

    /* Menu toggle */

    .site-header__menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      margin-left: auto;

      cursor: pointer;
      list-style: none;
    }

    .site-header__mobile[open] .site-header__menu-toggle {
      grid-column: 2;
      grid-row: 1;
    }

    .site-header__menu-toggle::-webkit-details-marker {
      display: none;
    }

    /* Hamburger icon */

    .site-header__menu-icon,
    .site-header__menu-icon::before,
    .site-header__menu-icon::after {
      display: block;
      width: 1.5rem;
      height: 2px;
      background-color: var(--color-text-primary);

      transition:
        transform 180ms ease,
        background-color 180ms ease;
    }

    .site-header__menu-icon {
      position: relative;
    }

    .site-header__menu-icon::before,
    .site-header__menu-icon::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .site-header__menu-icon::before {
      top: -0.45rem;
    }

    .site-header__menu-icon::after {
      top: 0.45rem;
    }

    /* Open icon state */

    .site-header__mobile[open] .site-header__menu-icon {
      background-color: transparent;
    }

    .site-header__mobile[open] .site-header__menu-icon::before {
      transform: translateY(0.45rem) rotate(45deg);
    }

    .site-header__mobile[open] .site-header__menu-icon::after {
      transform: translateY(-0.45rem) rotate(-45deg);
    }

    /* Expanded panel */

    .site-header__mobile-panel {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding-block: 4rem 1.5rem;
    }

    .site-header__mobile[open] .site-header__mobile-panel {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .site-header__mobile-panel > a {
      display: flex;
      align-items: center;
      min-height: 3.5rem;
      font-size: 1.125rem;
    }

    /* Mobile languages */

    .site-header__mobile-languages {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border-top: 1px solid var(--color-border-decorative);
    }

    .site-header__mobile-languages a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 3rem;
      min-height: 3rem;
    }
  }

  /* Reduced motion */

  @media (prefers-reduced-motion: reduce) {
    .site-header a,
    .site-header__menu-icon,
    .site-header__menu-icon::before,
    .site-header__menu-icon::after {
      transition: none;
    }
  }
</style>