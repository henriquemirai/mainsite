---
import BaseLayout from './base.astro';
import PageIntro from '../components/page-intro.astro';
import TextLink from '../components/text-link.astro';

interface Link {
  label: string;
  href: string;
}

interface Props {
  lang: 'en' | 'pt-BR';
  title: string;
  description: string;
  links?: Link[];
  biography: string[];
  image: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  callout: {
    text: string;
    link?: Link;
  };
}

const {
  lang,
  title,
  description,
  links = [],
  biography,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  callout,
} = Astro.props;

const languageLinks = {
  en: '/about/',
  ptBR: '/br/sobre/',
};
---

<BaseLayout
  lang={lang}
  title={title}
  languageLinks={languageLinks}
>
  <main class="about">

    <PageIntro
      title={title}
      description={description}
    />

    {links.length > 0 && (
      <ul class="about__links">
        {links.slice(0, 4).map((link) => (
          <li>
            <TextLink href={link.href}>
              {link.label}
            </TextLink>
          </li>
        ))}
      </ul>
    )}

    <div class="about__content">

      <div class="about__biography">
        {biography.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="about__profile">

        <img
          class="about__photo"
          src={image}
          alt={imageAlt}
          width={imageWidth}
          height={imageHeight}
          decoding="async"
        />

        <aside class="about__callout">
          <p>{callout.text}</p>

          {callout.link && (
            <a href={callout.link.href}>
              {callout.link.label}
            </a>
          )}
        </aside>

      </div>

    </div>

  </main>
</BaseLayout>

<style>
  /* Page structure */

  .about {
    padding-block: 3rem;
    align-items: start;
  }

  /* Auxiliary links */

  .about__links {
    grid-column: 4 / -1;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;

    margin-top: 1rem;
    list-style: none;

    font-size: var(--type-size-auxiliary);
    line-height: var(--type-leading-auxiliary);
  }

  /* Content grid */

  .about__content {
    grid-column: 1 / -1;

    display: grid;
    grid-template-columns: subgrid;
    align-items: start;

    margin-top: 2rem;
  }

  /* Biography */

  .about__biography {
    grid-column: 4 / -1;
    grid-row: 1;
    min-width: 0;

    display: flex;
    flex-direction: column;
    gap: 1.25rem;

    font-family: var(--font-body);
    font-size: var(--type-size-body);
    line-height: var(--type-leading-body);

    overflow-wrap: break-word;
  }

  /* Profile */

  .about__profile {
    grid-column: 1 / 4;
    grid-row: 1;
    min-width: 0;

    display: grid;

    border-radius: var(--radius);
  }

  .about__photo {
    grid-area: 1 / 1;

    display: block;
    width: 100%;
    height: auto;

    border-radius: var(--radius);
  }

  /* Personal callout */

  .about__callout {
    grid-area: 1 / 1;
    align-self: end;
    justify-self: start;
    z-index: 1;

    width: 65%;
    padding: 1.5rem;

    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    background-color: var(--color-ochre);
    color: var(--color-charcoal);

    border-bottom-left-radius: var(--radius);

    font-family: var(--font-body);
    font-size: 1rem;
    line-height: var(--type-leading-body);

    overflow-wrap: break-word;
  }

  .about__callout a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;

    align-self: flex-start;
  }

  .about__callout a:hover {
    text-decoration-thickness: 2px;
  }

  .about__callout a:focus-visible {
    outline: 2px solid var(--color-charcoal);
    outline-offset: 3px;
  }

  /* Tablet and mobile: stacked profile */

  @media (max-width: 74.999rem) {
    .about__photo {
      grid-area: auto;
      border-radius: var(--radius) var(--radius) 0 0;
    }

    .about__callout {
      grid-area: auto;
      width: 100%;
      border-radius: 0 0 var(--radius) var(--radius);
    }
  }

  /* Tablet */

  @media (min-width: 48rem) and (max-width: 74.999rem) {
    .about__links,
    .about__biography {
      grid-column: 3 / -1;
    }

    .about__profile {
      grid-column: 1 / 3;
    }
  }

  /* Mobile */

  @media (max-width: 47.999rem) {
    .about {
      padding-block: 2rem;
    }

    .about__links,
    .about__biography,
    .about__profile {
      grid-column: 1 / -1;
    }

    .about__biography,
    .about__profile {
      grid-row: auto;
    }

    .about__content {
      row-gap: 2rem;
    }

    .about__callout {
      padding: 1.25rem;
    }
  }
</style>