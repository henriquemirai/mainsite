---
import '../styles/global.css';

interface Props {
  lang: 'en' | 'pt-BR';
  title: string;
}

const { lang, title } = Astro.props;

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Commissioner:wght@400;500;600;700&family=Familjen+Grotesk:wght@400;500;600;700;900&family=Recursive:MONO@1&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body id="top">
    <div class="site-grid">
      <SiteHeader lang={lang} />
      <slot />
      <SiteFooter lang={lang} />
    </div>
  </body>
</html>

<style>
  .site-grid {
    width: 100%;
    max-width: var(--layout-container-max-width);
    margin-inline: auto;
    padding-inline: var(--layout-margin-inline);

    display: grid;
    grid-template-columns: repeat(
      var(--layout-grid-columns),
      minmax(0, 1fr)
    );
    column-gap: var(--layout-grid-gutter);
  }
</style>